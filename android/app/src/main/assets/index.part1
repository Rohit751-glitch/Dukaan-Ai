<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no"><meta name="theme-color" content="#f7f6fb">
<title>Chhotu_AI</title>
<style>
:root{--bg:#f6f5fa;--panel:#fff;--ink:#24212f;--muted:#7f798d;--line:#e8e5ef;--brand:#6758ef;--brand2:#887cf9;--soft:#f1efff;--green:#21855b;--greenSoft:#eaf8f1;--red:#bf4652;--redSoft:#fff0f1;--amber:#9b671d;--amberSoft:#fff4df;--shadow:0 18px 55px rgba(48,42,78,.09)}
*{box-sizing:border-box}html,body{height:100%;margin:0}body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans Devanagari","Nirmala UI",sans-serif;background:var(--bg);color:var(--ink);-webkit-tap-highlight-color:transparent}button,input,textarea,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(145deg,#7b6cff,#5848dd);position:relative;box-shadow:0 9px 25px rgba(91,75,220,.25);flex:0 0 auto}.logo:before{content:"";position:absolute;inset:9px 8px 10px;border-radius:11px 11px 13px 13px;background:#fff}.logo:after{content:"";position:absolute;width:5px;height:5px;background:#5e50df;border-radius:50%;top:19px;left:15px;box-shadow:12px 0 0 #5e50df}.logo-sm{width:28px;height:28px;border-radius:9px}.logo-sm:before{inset:6px 5px 7px}.logo-sm:after{width:3px;height:3px;top:13px;left:10px;box-shadow:8px 0 0 #5e50df}.spark{position:absolute;width:5px;height:5px;background:#ffd86a;right:-2px;top:5px;transform:rotate(45deg);border-radius:1px}
.login{min-height:100%;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 15% 10%,#ebe8ff 0,transparent 32%),radial-gradient(circle at 90% 88%,#e7f5ef 0,transparent 28%),#f7f6fb}.login-card{width:min(440px,100%);background:rgba(255,255,255,.94);border:1px solid #ece9f3;border-radius:30px;padding:42px 36px;box-shadow:var(--shadow)}.brand-row{display:flex;align-items:center;gap:12px;margin-bottom:30px}.brand-name{font-size:22px;font-weight:820;letter-spacing:-.04em}.brand-name span{color:var(--brand)}.login h1{font-size:38px;line-height:1.05;letter-spacing:-.055em;margin:0 0 10px}.login p{color:var(--muted);font-size:13px;line-height:1.55;margin:0 0 28px}.owner-chip{display:flex;align-items:center;gap:9px;padding:10px 12px;border:1px solid var(--line);background:#faf9fd;border-radius:13px;margin-bottom:12px;font-size:12px;color:#5f596b}.avatar{width:28px;height:28px;border-radius:9px;background:#ece9ff;color:#5f51db;display:grid;place-items:center;font-weight:800}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:12px}.field label{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#8d8797;font-weight:800}.field input{height:50px;border:1px solid #dedbe7;background:#fbfbfd;border-radius:14px;padding:0 14px;outline:none}.field input:focus{border-color:#9b90ff;box-shadow:0 0 0 4px #f0eeff;background:#fff}.primary{width:100%;height:50px;border:0;border-radius:14px;color:#fff;background:var(--ink);font-weight:760;box-shadow:0 9px 22px rgba(35,31,49,.14)}.login-status{font-size:11px;margin-top:12px!important;color:var(--red)!important;min-height:18px}
.app{height:100%;display:grid;grid-template-columns:230px 1fr}.side{background:#211f2a;color:#fff;padding:23px 17px;display:flex;flex-direction:column}.side .brand-row{margin-bottom:32px}.side .brand-name{font-size:18px}.side-sub{font-size:10px;color:#9f9aa9;margin:4px 0 0}.nav-title{font-size:9px;color:#7f7a88;text-transform:uppercase;letter-spacing:.12em;margin:14px 10px 8px}.nav-item{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:11px;color:#b7b2c0;font-size:11px}.nav-item.active{background:#2e2a3d;color:#fff}.nav-dot{width:7px;height:7px;border-radius:50%;background:#7263f2}.side-bottom{margin-top:auto;border-top:1px solid #34313e;padding-top:15px}.online{display:flex;gap:8px;align-items:center;font-size:10px;color:#aaa4b3}.online i{width:7px;height:7px;border-radius:50%;background:#3fc28a;box-shadow:0 0 0 4px rgba(63,194,138,.1)}.logout{margin-top:12px;width:100%;border:1px solid #413d4b;background:transparent;color:#aaa4b3;border-radius:10px;padding:9px;font-size:10px}
.workspace{min-width:0;display:grid;grid-template-rows:68px minmax(0,1fr) auto;height:100%}.topbar{background:rgba(255,255,255,.88);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;z-index:3}.top-title h2{font-size:17px;margin:0;letter-spacing:-.025em}.top-title p{font-size:10px;color:#9994a5;margin:4px 0 0}.status-pill{display:flex;align-items:center;gap:7px;font-size:9.5px;color:#6d6877;border:1px solid #e7e4ec;background:#fff;padding:7px 9px;border-radius:99px}.status-pill i{width:6px;height:6px;border-radius:50%;background:#38ba80}
.scroll{min-height:0;overflow:auto;padding:24px 28px 36px;scrollbar-width:thin}.content{width:min(960px,100%);margin:auto}.hero{display:flex;gap:13px;align-items:flex-start;background:linear-gradient(112deg,#f0edff,#fbfaff 66%,#edf8f3);border:1px solid #e4e0ff;border-radius:19px;padding:15px 16px;margin-bottom:24px}.hero-icon{width:35px;height:35px;border-radius:11px;background:#fff;color:var(--brand);display:grid;place-items:center;font-size:18px;box-shadow:0 5px 14px rgba(83,68,177,.11)}.hero strong{display:block;font-size:12px;margin-bottom:4px}.hero span{font-size:10.5px;color:#6f697b;line-height:1.5}.messages{display:flex;flex-direction:column;gap:17px}.msg{display:flex;gap:10px;align-items:flex-start}.msg.user{justify-content:flex-end}.bot-icon{width:29px;height:29px;border-radius:9px;background:linear-gradient(145deg,#7869ff,#5949de);color:#fff;display:grid;place-items:center;font-size:9px;font-weight:800;flex:0 0 auto;margin-top:3px}.bubble{max-width:min(840px,calc(100% - 40px));background:#fff;border:1px solid var(--line);box-shadow:0 8px 28px rgba(48,42,78,.045);border-radius:7px 18px 18px 18px;padding:13px 15px}.user .bubble{background:#24212f;color:#fff;border-color:#24212f;border-radius:18px 7px 18px 18px;max-width:82%}.bubble-text{font-size:13px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}.time{display:block;font-size:8.5px;color:#a09baa;margin-top:7px}.user .time{color:#a8a3b1;text-align:right}.activity{margin-top:10px;padding:9px 10px;background:#faf9fd;border:1px solid #efedf4;border-radius:11px;display:flex;flex-direction:column;gap:5px}.activity div{display:flex;align-items:center;gap:7px;font-size:9.5px;color:#817b8b}.activity i{width:5px;height:5px;border-radius:50%;background:#7566ef}.spinner{width:14px;height:14px;border:2px solid #dedbe8;border-top-color:var(--brand);border-radius:50%;display:inline-block;animation:spin .75s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.data-view{margin-top:12px;border:1px solid #e6e2ef;border-radius:16px;overflow:hidden;background:#fff}.data-head{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px 13px;background:#faf9fd;border-bottom:1px solid #ece9f2}.data-head strong{font-size:11px}.data-head span{font-size:9px;color:#8f8998}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;padding:11px}.metric{border:1px solid #ece9f2;background:#fff;border-radius:12px;padding:10px}.metric label{display:block;font-size:8.5px;text-transform:uppercase;letter-spacing:.05em;color:#918a9a;margin-bottom:5px}.metric b{font-size:17px;letter-spacing:-.03em}.table-scroll{overflow:auto}.smart-table{width:100%;border-collapse:collapse;min-width:560px}.smart-table th{font-size:8px;text-transform:uppercase;letter-spacing:.05em;color:#8c8695;background:#fcfbfe;text-align:left;padding:8px 9px;border-bottom:1px solid #ece9f2;white-space:nowrap}.smart-table td{font-size:10px;padding:9px;border-bottom:1px solid #f0eef4;white-space:nowrap}.smart-table tr:last-child td{border-bottom:0}.num{text-align:right!important;font-variant-numeric:tabular-nums}.stock-badge{display:inline-flex;align-items:center;justify-content:center;min-width:35px;padding:4px 7px;border-radius:99px;background:#edf8f3;color:#247d59;font-weight:800}.stock-badge.low{background:#fff1e1;color:#a46a16}.type-pill{padding:4px 7px;border-radius:99px;background:#f0edff;color:#6153db;font-size:8.5px;font-weight:800}
.approval{margin-top:13px;border:1px solid #ddd8ff;border-radius:16px;background:#fdfcff;overflow:hidden}.approval-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;padding:14px 15px 11px;background:linear-gradient(90deg,#f4f1ff,#fdfcff);border-bottom:1px solid #eae6ff}.eyebrow{font-size:8.5px;font-weight:850;lette